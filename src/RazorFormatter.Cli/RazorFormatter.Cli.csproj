<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RazorFormatter.Core\RazorFormatter.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Global Tool Packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>razor-format</ToolCommandName>
    <PackageId>RazorFormatter</PackageId>
    <Version>1.0.0</Version>
    <Authors>RazorFormatter Contributors</Authors>
    <Description>Fast, deterministic, Prettier-grade code formatter for ASP.NET Core Razor (.cshtml and .razor) files.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Khilaraj123/RazorFormatter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Khilaraj123/RazorFormatter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>razor;formatter;dotnet;cshtml;blazor;format</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>

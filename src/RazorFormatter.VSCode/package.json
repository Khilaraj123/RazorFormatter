{
  "name": "razor-code-formatter",
  "displayName": "Razor Formatter",
  "description": "Prettier-grade Razor (.cshtml / .razor) formatter for VS Code, Cursor, and Antigravity",
  "version": "0.1.1",
  "publisher": "razor-formatter",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Khilaraj123/RazorFormatter"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:aspnetcorerazor",
    "onLanguage:razor",
    "onLanguage:html"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Formatting Razor files requires workspace trust to prevent executing untrusted binaries."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "razorFormatter.formatDocument",
        "title": "RazorFormatter: Format Document",
        "category": "RazorFormatter"
      },
      {
        "command": "razorFormatter.formatWorkspace",
        "title": "RazorFormatter: Format Workspace",
        "category": "RazorFormatter"
      },
      {
        "command": "razorFormatter.checkFormatting",
        "title": "RazorFormatter: Check Formatting",
        "category": "RazorFormatter"
      },
      {
        "command": "razorFormatter.restartServer",
        "title": "RazorFormatter: Restart Formatter Server",
        "category": "RazorFormatter"
      }
    ],
    "configuration": {
      "title": "Razor Formatter",
      "properties": {
        "razorFormatter.serverMode": {
          "type": "boolean",
          "default": true,
          "description": "Run Razor Formatter as a persistent background daemon for sub-millisecond formatting without process restart overhead."
        },
        "razorFormatter.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show status notifications for workspace formatting and check operations."
        },
        "razorFormatter.indentSize": {
          "type": "integer",
          "default": 4,
          "description": "Number of spaces per indentation level."
        },
        "razorFormatter.indentStyle": {
          "type": "string",
          "enum": [
            "space",
            "tab"
          ],
          "default": "space",
          "description": "Indentation character style."
        },
        "razorFormatter.attributeLayout": {
          "type": "string",
          "enum": [
            "preserve",
            "one-per-line",
            "single-line"
          ],
          "default": "preserve",
          "description": "HTML and Tag Helper attribute layout strategy."
        },
        "razorFormatter.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional custom path to the razorfmt CLI executable or .dll. Configurable only in User/Machine settings for security."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}

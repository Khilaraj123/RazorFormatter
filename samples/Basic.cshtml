@page
@model BasicModel
@{
    ViewData["Title"] = "Basic Sample";
}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <title>@ViewData["Title"]</title>
    </head>
    <body>
        <!-- Header Section -->
        <header>
            <h1>Welcome to Razor Formatter</h1>
        </header>

        <main>
            <p>
                This is a sample document demonstrating HTML and basic Razor formatting.
            </p>
            <input type="text" placeholder="Enter your name" />
            <br />
            <button type="submit" class="btn btn-primary">
                Submit
            </button>
        </main>
    </body>
</html>

